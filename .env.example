# Backend secrets — copy to `.env` (git-ignored) and fill in.
# These are read by the Netlify Functions in netlify/functions/ and never
# reach the extension bundle.

# Anthropic API key for the /extract endpoint (Claude Messages API).
ANTHROPIC_API_KEY=

# Cesium ion token for the /geocode endpoint.
CESIUM_ION_TOKEN=

# ---------------------------------------------------------------------------
# Frontend vars live in `.env.local` instead (Vite inlines anything VITE_*):
#   VITE_API_BASE_URL=http://localhost:8888
#   VITE_CESIUM_ION_TOKEN=   # still needed by the Cesium sandbox for terrain
